# Sarjy web app — server-side configuration for POST /api/session.
#
# Copy to `.env.local` and fill in. Everything here is read by the API handler
# only (the Vite dev server in development, the Vercel Function in production).
#
# Do NOT prefix any of these with VITE_. Vite inlines VITE_* variables into the
# browser bundle, which would publish your LiveKit API secret to every visitor.

# LiveKit project, from https://cloud.livekit.io → Settings → Keys.
# Use the same project the agent connects to.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API000000000000
LIVEKIT_API_SECRET=your-livekit-api-secret

# Dispatch name of the agent to put in the room. Must match `agentName` in
# apps/sarjy-agent/src/main.ts. Optional: defaults to sarjy-agent.
# SARJY_AGENT_NAME=sarjy-agent

# Non-production agent deployment to dispatch to, e.g. staging.
# Optional: empty targets the production deployment.
# LIVEKIT_AGENT_DEPLOYMENT=

# Linear, for GET /api/tasks — the ticket rail and the agent's `get_tasks` tool.
#
# This app is the only place these live. The agent reaches Linear through
# GET /api/tasks rather than holding a key of its own, and the endpoint takes no
# team parameter, so it exposes exactly the one team configured here.

# Personal API key from https://linear.app/settings/account/security
# → Personal API keys. Needs write access if LINEAR_WRITES_ENABLED is on.
LINEAR_API_KEY=lin_api_your-personal-api-key

# The demo team's KEY, not its display name and not the workspace slug in the
# Linear URL. It is the short prefix on ticket identifiers — the "ENG" in
# ENG-482 — and is shown under Settings → Teams for each team.
# Matched case-insensitively against the teams the API key can see.
LINEAR_TEAM_KEY=SAR

# Server-only shared memory. Never use VITE_ prefixes for these values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Generate once and configure the identical value on the agent.
MEMORY_API_TOKEN=replace-with-a-generated-token

# Let the agent change ticket status and comment (POST /api/task-updates).
# Off unless exactly `true`. Anyone who opens the demo can talk to the agent.
LINEAR_WRITES_ENABLED=false
