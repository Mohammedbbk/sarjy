
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API000000000000
LIVEKIT_API_SECRET=your-livekit-api-secret

LINEAR_API_KEY=lin_api_your-personal-api-key

LINEAR_TEAM_KEY=SAR

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Maximum active visitor identities. Optional: defaults to 20.
# SARJY_VISITOR_CAPACITY=20

# The public URL of this deployment, passed to the agent worker in the dispatch
# metadata so it knows where to call back. Optional: the agent falls back to its
# own SARJY_API_URL. Set it when the two could disagree, e.g. preview deploys.
# SARJY_PUBLIC_API_URL=https://sarjy-two.vercel.app

# Sarjy never writes to Linear. The configured team is a shared demo board.

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------

# A throwaway Postgres for the SQL integration tests, which exercise the
# transactional rules (visitor isolation, revision conflicts, request replay,
# room binding, and finish prerequisites) that mocks cannot demonstrate.
#
# The suite skips itself when this is unset, and refuses any database whose name
# does not contain "test", so it can never be aimed at the deployment database.
#
#   createdb sarjy_test
#   SARJY_TEST_DATABASE_URL=postgresql://localhost:5432/sarjy_test pnpm test
#
# SARJY_TEST_DATABASE_URL=postgresql://localhost:5432/sarjy_test
