# sarjy-agent — LiveKit credentials for the agent worker.
#
# Copy to `.env.local` and fill in. Use the same LiveKit project as the web app
# (apps/web/.env.local), or the agent will never be dispatched into its rooms.
#
# The agent registers under the dispatch name `sarjy-agent` (see
# `agentName` in src/main.ts) and only joins rooms whose token asks for it.

# LiveKit project, from https://cloud.livekit.io → Settings → Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API000000000000
LIVEKIT_API_SECRET=your-livekit-api-secret

# The web app that owns the Linear integration, for the agent's read-only
# `get_tasks` tool (src/tasks.ts). The agent calls GET /api/tasks there.
#
# The agent holds no Linear credentials: LINEAR_API_KEY and LINEAR_TEAM_KEY
# live in the web app's environment only (apps/web/.env.example). That keeps one
# integration in one place, and means the tickets on screen and the tickets
# Sarjy reads are the same response from the same endpoint.
#
# Locally this is the Vite dev server. In production, point it at the deployed
# web app, e.g. https://sarjy.vercel.app. Without it, `get_tasks` returns a
# configuration error and Sarjy says it could not reach the task list.
SARJY_API_URL=http://localhost:5180

# Same token as Web/Vercel. Memory and ticket-update calls use SARJY_API_URL above.
# Supabase credentials belong only on the web backend.
MEMORY_API_TOKEN=replace-with-a-generated-token
